class CPU ///////////////
{
	string name;
	string frequency;

public:
	CPU()
	{
		name = "Intel I7";
		frequency = "10 MHz";
	}

	CPU(const char* N, const char* F)
	{
		name = N;
		frequency = F;
	}
	string GetName() const
	{
		return name;
	}
	string GetFrequency() const
	{
		return frequency;
	}
};

