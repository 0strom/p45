class PC
{
	string brand;
	string model;
	friend class Print;

	CPU cpu;
	GPU gpu;
	RAM ram;
	SSD ssd;
	Display display;
	Battery battery;
	Keyboard keyboard;
	Mouse mouse;

public:
	PC(const string& b, const string& m) : brand(b), model(m) {}
};

// 3. Print Class Defined Last

class Print {
public:
	void Output_PC(const PC& obj) {
		cout << "Brand:" << obj.brand << endl;
		cout << "Model:" << obj.model << endl;
		cout << "CPU:" << obj.cpu.GetName() << " " << obj.cpu.GetFrequency() << endl;
		cout << "GPU:" << obj.gpu.GetName() << " " << obj.gpu.GetCapacity() << endl;
		cout << "RAM:" << obj.ram.GetCapacity() << " " << obj.ram.GetType() << endl;
		cout << "SSD:" << obj.ssd.GetName() << " " << obj.ssd.GetCapacity() << endl;
		cout << "Display:" << obj.display.GetMatrix() << " " << obj.display.GetResolution() << endl;
		cout << "Battery:" << obj.battery.GetCapacity() << " " << obj.battery.GetType() << endl;
		cout << "Keyboard:" << obj.keyboard.GetLayout() << " " << obj.keyboard.GetSize() << endl;
		cout << "Mouse:" << obj.mouse.GetName() << " " << obj.mouse.GetDPI() << endl;
	}
};



int main()
{
	PC obj1("Apple", "Macbook Pro");

	Print obj;
	obj.Output_PC(obj1);

	return 0;
 }
  
