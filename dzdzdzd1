class Program
{
    static void Main()
    {

        Website website = new Website();

        Console.WriteLine("Website info:");
        website.Input();
        Console.WriteLine("\nWebsite info:");
        Console.WriteLine(website);


        Journal j1 = new Journal();
        j1.Input();

        Journal j2 = new Journal();
        j2.Input();

