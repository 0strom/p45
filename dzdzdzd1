using System;

class Website
{
    public string Name { get; set; }
    public string Path { get; set; }
    public string Description { get; set; }
    public string Address { get; set; }

    public void Input()
    {
        Console.Write("Website name: ");
        Name = Console.ReadLine();

        Console.Write("Website path: ");
        Path = Console.ReadLine();

        Console.Write("Description: ");
        Description = Console.ReadLine();

        Console.Write("Website address: ");
        Address = Console.ReadLine();
    }

    public override string ToString()
    {
        return "Name: " + Name + "\n" +
               "Path: " + Path + "\n" +
               "Description: " + Description + "\n" +
               "Address: " + Address;
    }
}



class Journal
{
    private string name = "";
    private int year;
    private string description = "";
    private string phone = "";
    private string email = "";
    private int employees;

   

    public string Name
    {
        get { return name; }
        set { name = value; }
    }
    public int Year
    {
        get { return year; }
        set { year = value; }
    }
    public string Description
    {
        get { return description; }
        set { description = value; }
    }
    public string Phone
    {
        get { return phone; }
        set { phone = value; }
    }
    public string Email
    {
        get { return email; }
        set { email = value; }
    }

    public int Employees
    {
        get { return employees; }
        set
        {
            if (value < 0)
                throw new ArgumentException(
                    "Employees must be real");

            employees = value;
        }
    }


    public void Input()
    {
        Console.Write("Name: ");
        Name = Console.ReadLine();

        Console.Write("Year: ");
        Year = Convert.ToInt32(Console.ReadLine());

        Console.Write("Description: ");
        Description = Console.ReadLine();

        Console.Write("Phone: ");
        Phone = Console.ReadLine();

        Console.Write("Email: ");
        Email = Console.ReadLine();

        Console.Write("Employees: ");
        Employees = Convert.ToInt32(Console.ReadLine());
    }

    public override string ToString()
    {
        string result = "Journal name: " + Name + "\n";
        result += "Year: " + Year + "\n";
        result += "Description: " + Description + "\n";
        result += "Phone: " + Phone + "\n";
        result += "Email: " + Email + "\n";
        result += "Employees: " + Employees;

        return result;
    }

    
    public static Journal operator +(Journal journal, int amount)
    {
        return new Journal
        {
            Name = journal.Name,
            Year = journal.Year,
            Description = journal.Description,
            Phone = journal.Phone,
            Email = journal.Email,
            Employees = checked(journal.Employees + amount)
        };
    }

   
    public static Journal operator -(Journal journal, int amount)
    {
        return new Journal
        {
            Name = journal.Name,
            Year = journal.Year,
            Description = journal.Description,
            Phone = journal.Phone,
            Email = journal.Email,
            Employees = checked(journal.Employees - amount)
        };
    }

    

    public static bool operator ==(Journal a, Journal b)
    {
        if (ReferenceEquals(a, b))
            return true;

        if (a is null || b is null)
            return false;

        return a.Employees == b.Employees;
    }

    

    public static bool operator !=(Journal a, Journal b)
    {
        return !(a == b);
    }

    
    public static bool operator >(Journal a, Journal b)
    {
        if (a is null || b is null)
            return false;

        return a.Employees > b.Employees;
    }

   
    public static bool operator <(Journal a, Journal b)
    {
        if (a is null || b is null)
            return b is not null;

        return b is not null && a.Employees < b.Employees;
    }

   
    public override bool Equals(object? obj)
    {
        if (obj is not Journal other)
            return false;

        return Employees == other.Employees;
    }

    public override int GetHashCode()
    {
        return Employees.GetHashCode();
    }
}




