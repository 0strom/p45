#include <iostream>
using namespace std;


// 1
class IOutput {
public:

    virtual ~IOutput() {}
    virtual void Show() const = 0;
    virtual void Show(string info) const = 0;
};

// 2
class IMath {
public:

    virtual ~IMath() {}
    virtual int Max() const = 0;
    virtual int Min() const = 0;
    virtual float Avg() const = 0;
    virtual bool Search(int target) const = 0;
};

// 3
class ISort {
public:

    virtual ~ISort() {}
    virtual void SortAsc() = 0;
    virtual void SortDesc() = 0;
    virtual void SortByParam(bool isAsc) = 0;
};



class Array : public IOutput, public IMath, public ISort {
private:
    int arr[333];
    int sz;

public:
    Array(int a[], int n) {
        sz = n;

        for (int i = 0; i < sz; i++) {
            arr[i] = a[i];
        }
    }



    //////////////////////////
  
    void Show() const override {
        cout << "Array:";
        for (int i = 0; i < sz; i++) {
            cout << arr[i] << " ";
        }
        cout << endl;
    }

    void Show(string info) const override {
        cout  << info;
        for (int i = 0; i < sz; i++) {
            cout << arr[i] << " ";
        }

        cout << endl;
    }


    //////////////////////////
    int Max() const override {
        int mx = arr[0];
        for (int i = 1; i < sz; i++) {
            if (arr[i] > mx) {
                mx = arr[i];
            }
        }

        return mx;
    }

    int Min() const override {
        int mn = arr[0];
        for (int i = 1; i < sz; i++) {
            if (arr[i] < mn) {
                mn = arr[i];
            }
        }

        return mn;
    }

    float Avg() const override {
        float sum = 0;
        for (int i = 0; i < sz; i++) {
            sum += arr[i];
        }
        return sum / sz;
    }

    bool Search(int target) const override {
        for (int i = 0; i < sz; i++) {
            if (arr[i] == target) {
                return true;
            }
        }
        return false;
    }



    //////////////////////////
    void SortAsc() override {
        for (int i = 0; i < sz - 1; i++) {
            for (int j = 0; j < sz - i - 1; j++) {
                if (arr[j] > arr[j + 1]) {
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }
    }

    void SortDesc() override {
        for (int i = 0; i < sz - 1; i++) {
            for (int j = 0; j < sz - i - 1; j++) {
                if (arr[j] < arr[j + 1]) {
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }
    }

    void SortByParam(bool isAsc) override {

        if (isAsc) {
            SortAsc();
        }

        else {
            SortDesc();
        }
    }
};







