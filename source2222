#include <iostream>
using namespace std;



void task1() {
    int arr[] = { 10, 100, 99 };
    int size = 3;
    int totalSum = 0;

    for (int i = 0; i < size; i++) {
        int temp = arr[i];

        if (temp < 0) {
            temp = -temp;
        }


        if (temp == 0) {
            totalSum += 0;
        }

       
        while (temp > 0) {
            totalSum += temp % 10; 
            temp /= 10;            
        }
    }

    cout << "result: " << totalSum << endl << endl;
}


void task2() {
    int arr[] = { -5, 10, 0, 9, -3, 4 };
    int size = 6;

    double sum = 0;
    int count = 0;

    for (int i = 0; i < size; i++) {
        if (arr[i] > 0) {
            sum += arr[i];
            count++;
        }
    }

    if (count == 0) {
        cout << "no positive numbs" << endl << endl;
    }
    else {
        cout << "result: " << sum / count << endl << endl;
    }
}


void task3() {
    int arr[] = { -10, 5, -2};
    int size = 3;

    int maxNeg = 0;
    int maxIdx = -1;
    bool found = false;

    for (int i = 0; i < size; i++) {
        if (arr[i] < 0) {
            if (!found || arr[i] > maxNeg) {
                maxNeg = arr[i];
                maxIdx = i;
                found = true;
            }
        }
    }

    if (!found) {
        cout << "no negative numbs" << endl << endl;
    }
    else {
        cout << "Value: " << maxNeg << ", Index: " << maxIdx << endl << endl;
    }
}


void task4() {
  
    int arr[] = { 1, 3, 2, 3, 4, 6, 2, 1, 5, 3};
    int size = 10;

    int mostFreqNum = arr[0];
    int maxCount = 0;

    
    for (int i = 0; i < size; i++) {
        int count = 0;
        for (int j = 0; j < size; j++) {
            if (arr[i] == arr[j]) {
                count++;
            }
        }
        if (count > maxCount) {
            maxCount = count;
            mostFreqNum = arr[i];
        }
    }

    cout << "result: " << mostFreqNum << endl << endl;
}


void task5() {
    int arr[] = { 10, 9, 4, 12, 5, 15, 8 };
    int size = 7;

    int maxVal = 0;
    bool found = false;

    for (int i = 1; i < size; i += 2) {
        if (arr[i] % 3 == 0) {
            if (!found || arr[i] > maxVal) {
                maxVal = arr[i];
                found = true;
            }
        }
    }

    if (!found) {
        cout << "no required numbs" << endl << endl;
    }
    else {
        cout << "Biggest number: " << maxVal << endl << endl;
    }
}


void task6() {
    
    int arr[] = { 4, 7, 2, 9, 1, 8 };
    int size = 6;

    int maxEven = 0, minOdd = 0;
    int maxEvenIdx = -1, minOddIdx = -1;

    for (int i = 0; i < size; i++) {
        if (arr[i] % 2 == 0) { 
            if (maxEvenIdx == -1 || arr[i] > maxEven) {
                maxEven = arr[i];
                maxEvenIdx = i;
            }
        }

        else { 
            if (minOddIdx == -1 || arr[i] < minOdd) {
                minOdd = arr[i];
                minOddIdx = i;
            }
        }
    }


  
    if (maxEvenIdx == -1 || minOddIdx == -1) {
        for (int i = 0; i < size; i++) {
            arr[i] = 0;
        }
    }
    else {
        

        int temp = arr[maxEvenIdx];
        arr[maxEvenIdx] = arr[minOddIdx];
        arr[minOddIdx] = temp;
    }

    cout << "result: ";
    for (int i = 0; i < size; i++) {
        cout << arr[i] << " ";
    }
    cout << endl << endl;
}


void task7() {
    int a[] = { 1, 2, 3, 4, 5 };
    int sizeA = 5;

    int b[] = { 4, 5, 6, 7 };
    int sizeB = 4;

   
    cout << "а)In both arrays: ";
    for (int i = 0; i < sizeA; i++) {
        for (int j = 0; j < sizeB; j++) {
            if (a[i] == b[j]) {
                cout << a[i] << " ";
            }
        }
    }
    cout << endl;

  
    cout << "б)In one of the arrays: ";

   

    for (int i = 0; i < sizeA; i++) {
        bool foundInB = false;
        for (int j = 0; j < sizeB; j++) {
            if (a[i] == b[j]) {
                foundInB = true;
                break;
            }
        }
        if (!foundInB) {
            cout << a[i] << " ";
        }
    }

    
    for (int j = 0; j < sizeB; j++) {
        bool foundInA = false;
        for (int i = 0; i < sizeA; i++) {
            if (b[j] == a[i]) {
                foundInA = true;
                break;
            }
        }
        if (!foundInA) {
            cout << b[j] << " ";
        }
    }
    cout << endl << endl;
}


